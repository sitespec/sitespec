    "node": ">=22"
  },
  "description": "Default standalone website template for SiteSpec.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "sitespec",
    "static-site",
    "ai",
    "cms"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sitespec/sitespec",
    "directory": "packages/template"
  }
}
