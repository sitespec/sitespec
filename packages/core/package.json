{
  "name": "@sitespec/core",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Deterministic SiteSpec parser, resolver, validator, and inspection API.",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "sitespec",
    "static-site",
    "ai",
    "cms"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sitespec/sitespec",
    "directory": "packages/core"
  }
