{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:site-spec:page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "page",
    "sections"
  ],
  "properties": {
    "specVersion": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route",
        "archetype"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "archetype": {
          "enum": [
            "marketing",
            "article",
            "listing",
            "detail",
            "legal",
            "blank"
          ]
        },
        "state": {
          "enum": [
            "draft",
            "published"
          ]
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/routeSegment"
            }
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "noindex": {
          "type": "boolean"
        }
      }
    },
    "structuredData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "Organization",
            "WebSite",
            "WebPage",
            "Article",
            "Product",
            "FAQPage",
            "BreadcrumbList"
          ]
        },
        "data": {
          "type": "object"
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/section"
          },
          {
            "$ref": "#/$defs/sectionRef"
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "routeSegment": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "route": {
      "type": "string",
      "pattern": "^/$|^/(?:[a-z0-9]+(?:-[a-z0-9]+)*|\\[[a-z][a-z0-9-]*\\])(?:/(?:[a-z0-9]+(?:-[a-z0-9]+)*|\\[[a-z][a-z0-9-]*\\]))*$"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "use"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "use": {
          "$ref": "#/$defs/id"
        },
        "variant": {
          "$ref": "#/$defs/id"
        },
        "theme": {
          "$ref": "#/$defs/id"
        },
        "props": {
          "type": "object"
        }
      }
    },
    "sectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "$ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "$ref": {
          "type": "string",
          "pattern": "^section:[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)*$"
        }
      }
    }
  }
}
