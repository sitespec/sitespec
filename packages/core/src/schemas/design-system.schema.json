{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:site-spec:0.4:design-system",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "designSystem",
    "tokens",
    "fonts",
    "themes",
    "layout",
    "libraries",
    "shells"
  ],
  "properties": {
    "specVersion": {
      "const": "0.4"
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "extension",
        "rules"
      ],
      "properties": {
        "source": {
          "const": "design/tokens.json"
        },
        "extension": {
          "const": "design/extensions.json"
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primitive",
            "semantic"
          ],
          "properties": {
            "primitive": {
              "enum": [
                "locked",
                "additive"
              ]
            },
            "semantic": {
              "enum": [
                "locked",
                "additive"
              ]
            }
          }
        }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "assetsRoot"
      ],
      "properties": {
        "source": {
          "const": "design/fonts.yaml"
        },
        "assetsRoot": {
          "const": "public/fonts"
        }
      }
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "items"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/id"
        },
        "items": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "source": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convention",
        "tokens"
      ],
      "properties": {
        "convention": {
          "const": "outer-gutter-inner-container"
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pageGutter",
            "contentWidth",
            "sectionSpacing"
          ],
          "properties": {
            "pageGutter": {
              "$ref": "#/$defs/tokenPath"
            },
            "contentWidth": {
              "$ref": "#/$defs/tokenPath"
            },
            "sectionSpacing": {
              "$ref": "#/$defs/tokenPath"
            }
          }
        }
      }
    },
    "libraries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui",
        "sections",
        "presets"
      ],
      "properties": {
        "ui": {
          "$ref": "#/$defs/idList"
        },
        "sections": {
          "$ref": "#/$defs/idList"
        },
        "presets": {
          "$ref": "#/$defs/presetList"
        }
      }
    },
    "shells": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "items"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/id"
        },
        "items": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry",
              "files"
            ],
            "properties": {
              "entry": {
                "$ref": "#/$defs/relativePath"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/relativePath"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "tokenPath": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "presetList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)*$"
      }
    }
  }
}
