{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:site-spec:0.1:type:action",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "href"],
  "properties": {
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "href": { "type": "string", "minLength": 1 },
    "target": { "enum": ["self", "blank"] }
  }
}
