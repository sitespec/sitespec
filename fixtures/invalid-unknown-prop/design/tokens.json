{
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": "#ffffff" },
      "neutral50": { "$type": "color", "$value": "#f5f5f3" },
      "neutral200": { "$type": "color", "$value": "#deded8" },
      "neutral500": { "$type": "color", "$value": "#68685f" },
      "neutral700": { "$type": "color", "$value": "#c8c8be" },
      "neutral900": { "$type": "color", "$value": "#171713" },
      "neutral950": { "$type": "color", "$value": "#11110f" },
      "brand600": { "$type": "color", "$value": "#5b48e8" }
    },
    "space": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "1rem" },
      "md": { "$type": "dimension", "$value": "1.5rem" },
      "lg": { "$type": "dimension", "$value": "2rem" },
      "xl": { "$type": "dimension", "$value": "3rem" },
      "controlY": { "$type": "dimension", "$value": "0.8rem" },
      "controlX": { "$type": "dimension", "$value": "1.05rem" },
      "page": { "$type": "dimension", "$value": "clamp(1.25rem, 4vw, 4rem)" },
      "section": { "$type": "dimension", "$value": "clamp(4.5rem, 9vw, 8rem)" }
    },
    "size": {
      "content": { "$type": "dimension", "$value": "72rem" }
    },
    "radius": {
      "control": { "$type": "dimension", "$value": "0.7rem" },
      "card": { "$type": "dimension", "$value": "1rem" }
    },
    "font": {
      "family": {
        "sans": { "$type": "fontFamily", "$value": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif" }
      },
      "size": {
        "small": { "$type": "dimension", "$value": "0.8rem" },
        "lead": { "$type": "dimension", "$value": "1.2rem" },
        "subheading": { "$type": "dimension", "$value": "1.25rem" },
        "heading": { "$type": "dimension", "$value": "clamp(2rem, 5vw, 3.75rem)" },
        "display": { "$type": "dimension", "$value": "clamp(2.75rem, 7vw, 5.5rem)" }
      },
      "lineHeight": {
        "display": { "$type": "number", "$value": 0.98 },
        "heading": { "$type": "number", "$value": 1.05 },
        "lead": { "$type": "number", "$value": 1.55 },
        "body": { "$type": "number", "$value": 1.6 }
      }
    }
  },
  "semantic": {
    "color": {
      "surface": {
        "default": { "$type": "color", "$value": "{primitive.color.white}" },
        "muted": { "$type": "color", "$value": "{primitive.color.neutral50}" },
        "card": { "$type": "color", "$value": "{primitive.color.white}" },
        "inverted": { "$type": "color", "$value": "{primitive.color.neutral950}" }
      },
      "text": {
        "default": { "$type": "color", "$value": "{primitive.color.neutral900}" },
        "muted": { "$type": "color", "$value": "{primitive.color.neutral500}" },
        "inverted": { "$type": "color", "$value": "{primitive.color.white}" },
        "invertedMuted": { "$type": "color", "$value": "{primitive.color.neutral700}" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{primitive.color.brand600}" },
        "contrast": { "$type": "color", "$value": "{primitive.color.white}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{primitive.color.neutral200}" }
      }
    },
    "space": {
      "stack": {
        "sm": { "$type": "dimension", "$value": "{primitive.space.xs}" },
        "md": { "$type": "dimension", "$value": "{primitive.space.sm}" },
        "lg": { "$type": "dimension", "$value": "{primitive.space.md}" },
        "xl": { "$type": "dimension", "$value": "{primitive.space.lg}" },
        "2xl": { "$type": "dimension", "$value": "{primitive.space.xl}" }
      },
      "control": {
        "y": { "$type": "dimension", "$value": "{primitive.space.controlY}" },
        "x": { "$type": "dimension", "$value": "{primitive.space.controlX}" }
      },
      "page": { "$type": "dimension", "$value": "{primitive.space.page}" },
      "section": { "$type": "dimension", "$value": "{primitive.space.section}" }
    },
    "size": {
      "content": { "$type": "dimension", "$value": "{primitive.size.content}" }
    },
    "radius": {
      "control": { "$type": "dimension", "$value": "{primitive.radius.control}" },
      "card": { "$type": "dimension", "$value": "{primitive.radius.card}" }
    },
    "font": {
      "family": {
        "body": { "$type": "fontFamily", "$value": "{primitive.font.family.sans}" },
        "heading": { "$type": "fontFamily", "$value": "{primitive.font.family.sans}" }
      },
      "size": {
        "small": { "$type": "dimension", "$value": "{primitive.font.size.small}" },
        "lead": { "$type": "dimension", "$value": "{primitive.font.size.lead}" },
        "subheading": { "$type": "dimension", "$value": "{primitive.font.size.subheading}" },
        "heading": { "$type": "dimension", "$value": "{primitive.font.size.heading}" },
        "display": { "$type": "dimension", "$value": "{primitive.font.size.display}" }
      },
      "lineHeight": {
        "display": { "$type": "number", "$value": "{primitive.font.lineHeight.display}" },
        "heading": { "$type": "number", "$value": "{primitive.font.lineHeight.heading}" },
        "lead": { "$type": "number", "$value": "{primitive.font.lineHeight.lead}" },
        "body": { "$type": "number", "$value": "{primitive.font.lineHeight.body}" }
      }
    }
  }
}
