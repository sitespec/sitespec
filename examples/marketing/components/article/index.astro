---
import Container from "../../ui/container/index.astro";
interface Related { id: string; name: string; href: string }
interface MarkdownBody { format: "markdown"; source: string; html: string }
interface ArticleProps {
  title: string;
  description: string;
  date: string;
  body: MarkdownBody;
  author: Related;
  categories: Related[];
  tags: Related[];
}
interface Props { sectionId: string; variant: string; theme: string; props: ArticleProps }
const { sectionId, variant, theme, props } = Astro.props;
---
<section id={sectionId} data-section={sectionId} data-component="article" data-variant={variant} data-theme={theme}>
  <Container>
    <article>
      <div class="meta">
        <time datetime={props.date}>{props.date}</time>
        <span>by <a href={props.author.href}>{props.author.name}</a></span>
      </div>
      <h1>{props.title}</h1>
      <p class="lead">{props.description}</p>
      <div class="taxonomies">
        <div class="taxonomy"><strong>Categories</strong>{props.categories.map((item) => <a href={item.href}>{item.name}</a>)}</div>
        <div class="taxonomy"><strong>Tags</strong>{props.tags.map((item) => <a href={item.href}>{item.name}</a>)}</div>
      </div>
      <div class="body" set:html={props.body.html}></div>
    </article>
  </Container>
</section>
<style>
  section { padding: var(--space-section) var(--space-page); background: var(--color-surface-default); color: var(--color-text-default); }
  article { max-width: var(--size-content); }
  .meta, .taxonomies, .taxonomy { display: flex; flex-wrap: wrap; gap: var(--space-stack-md); color: var(--color-text-muted); font-size: var(--font-size-small); }
  .meta { margin-bottom: var(--space-stack-md); }
  h1 { margin: 0; font-size: var(--font-size-display); line-height: var(--font-line-height-display); letter-spacing: -.045em; }
  .lead { margin: var(--space-stack-lg) 0 0; color: var(--color-text-muted); font-size: var(--font-size-lead); line-height: var(--font-line-height-lead); }
  .taxonomies { margin-top: var(--space-stack-lg); }
  a { color: inherit; text-underline-offset: .18em; }
  .body { margin-top: var(--space-stack-2xl); line-height: var(--font-line-height-body); }
  .body :global(h2) { margin: var(--space-stack-2xl) 0 var(--space-stack-md); font-size: var(--font-size-heading); }
  .body :global(p), .body :global(ul), .body :global(ol), .body :global(blockquote), .body :global(pre) { margin: 0 0 var(--space-stack-lg); }
  .body :global(a) { text-underline-offset: .18em; }
</style>
