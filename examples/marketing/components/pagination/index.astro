---
import Container from "../../ui/container/index.astro";
interface PageLink { page: number; href: string; current?: boolean }
interface PaginationProps {
  currentPage: number;
  totalPages: number;
  previousHref?: string;
  nextHref?: string;
  pages?: PageLink[];
}
interface Props { sectionId: string; variant: string; theme: string; props: PaginationProps }
const { sectionId, variant, theme, props } = Astro.props;
---
<section id={sectionId} data-section={sectionId} data-component="pagination" data-variant={variant} data-theme={theme}>
  <Container>
    <nav aria-label="Pagination">
      <div class="summary">Page {props.currentPage} of {props.totalPages}</div>
      <div class="controls">
        {props.previousHref
          ? <a class="direction" href={props.previousHref} rel="prev">Previous</a>
          : <span class="direction disabled" aria-disabled="true">Previous</span>}

        {props.pages && props.pages.length > 0 && (
          <ol>
            {props.pages.map((item) => (
              <li>
                <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.page}</a>
              </li>
            ))}
          </ol>
        )}

        {props.nextHref
          ? <a class="direction" href={props.nextHref} rel="next">Next</a>
          : <span class="direction disabled" aria-disabled="true">Next</span>}
      </div>
    </nav>
  </Container>
</section>

<style>
  section { padding: var(--space-stack-xl) var(--space-page) var(--space-section); background: var(--color-surface-default); color: var(--color-text-default); }
  section[data-theme="muted"] { background: var(--color-surface-muted); }
  nav { display: grid; gap: var(--space-stack-md); }
  .summary { color: var(--color-text-muted); font-size: var(--font-size-small); }
  .controls { display: flex; align-items: center; justify-content: space-between; gap: var(--space-stack-md); }
  ol { display: flex; flex-wrap: wrap; gap: var(--space-stack-sm); margin: 0; padding: 0; list-style: none; }
  a, .direction { display: inline-flex; align-items: center; justify-content: center; min-width: var(--space-stack-2xl); padding: var(--space-control-y) var(--space-control-x); border: 1px solid var(--color-border-default); border-radius: var(--radius-control); text-decoration: none; }
  a[aria-current="page"] { border-color: var(--color-accent-default); background: var(--color-accent-default); color: var(--color-accent-contrast); }
  .disabled { color: var(--color-text-muted); }
  @media (max-width: 760px) { .controls { align-items: stretch; flex-direction: column; } ol { order: -1; } }
</style>
