---
import Container from "../../ui/container/index.astro";
interface Item { title: string; text: string }
interface FeatureGridProps { title: string; items: Item[] }
interface Props { sectionId: string; variant: string; theme: string; props: FeatureGridProps }
const { sectionId, variant, theme, props } = Astro.props;
---
<section id={sectionId} data-section={sectionId} data-component="feature-grid" data-variant={variant} data-theme={theme}>
  <Container>
    <h2>{props.title}</h2>
    <div class="grid">
      {props.items.map((item) => (
        <article>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  section { padding: var(--space-section) var(--space-page); background: var(--color-surface-default); color: var(--color-text-default); }
  section[data-theme="muted"] { background: var(--color-surface-muted); }
  h2 { max-width: 720px; margin: 0 0 var(--space-stack-2xl); font-size: var(--font-size-heading); letter-spacing: -.035em; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-stack-md); }
  article { padding: var(--space-stack-xl); border: 1px solid var(--color-border-default); border-radius: var(--radius-card); background: var(--color-surface-card); }
  h3 { margin: 0 0 var(--space-stack-sm); font-size: var(--font-size-subheading); }
  p { margin: 0; line-height: var(--font-line-height-body); color: var(--color-text-muted); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
